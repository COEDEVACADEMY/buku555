{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./*"
      ],
      "@expo/vector-icons": [
        "./node_modules/@expo/vector-icons"
      ],
      "@react-navigation/native": [
        "./node_modules/@react-navigation/native"
      ]
    },
    "jsx": "react-native",
    "esModuleInterop": true,
    "typeRoots": [
      "./node_modules/@types",
      "./types"
    ]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
